<article class="rounded-xl border border-orange-100 bg-white p-6 shadow-sm">
  <h2 class="text-xl font-semibold">
    <a href="/recipe/{{ recipe.id }}/" class="hover:text-orange-700">{{ recipe.name }}</a>
  </h2>
  {% if recipe.description %}
    <p class="mt-3 leading-6 text-stone-600">{{ recipe.description }}</p>
  {% endif %}
  <a href="/recipe/{{ recipe.id }}/" class="mt-5 inline-block text-sm font-semibold text-orange-700 hover:underline">
    View recipe
  </a>
</article>