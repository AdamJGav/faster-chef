{% extends "base.jinja" %}

{% block title %}{{ recipe.name }} | Faster Chef{% endblock %}
{% block meta_description %}{{ recipe.description or recipe.name }}{% endblock %}

{% block content %}
  <article>
    <a href="/recipes/" class="text-sm font-semibold text-orange-700 hover:underline">&larr; All recipes</a>
    <header class="mt-6 border-b border-orange-100 pb-6">
      <div class="flex items-center justify-between">
        <h1 class="text-4xl font-bold tracking-tight">{{ recipe.name }}</h1>
        <a href="/recipe_form/{{ recipe.id }}">
          <button class="float-right bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
            Edit Recipe
          </button>
        </a>
      </div>
      {% if recipe.description %}
        <p class="mt-4 max-w-3xl text-lg leading-7 text-stone-600">{{ recipe.description }}</p>
      {% endif %}
    </header>

    <section class="mt-8">
      <h2 class="text-2xl font-semibold">Ingredients</h2>
      {% if recipe.ingredients.all() %}
        <ul class="mt-4 space-y-3">
          {% for ingredient in recipe.ingredients.all() %}
            <li class="rounded-lg bg-white px-4 py-3 shadow-sm">
              <span class="font-medium">{{ ingredient.name }}</span>
              {% if ingredient.quantity or ingredient.unit %}
                <span class="text-stone-600"> &mdash; {{ ingredient.quantity }} {{ ingredient.unit }}</span>
              {% endif %}
              {% if ingredient.notes %}
                <p class="mt-1 text-sm text-stone-500">{{ ingredient.notes }}</p>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="mt-3 text-stone-600">No ingredients added yet.</p>
      {% endif %}
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-semibold">Method</h2>
      {% if recipe.steps.all() %}
        <ol class="mt-4 space-y-4">
          {% for step in recipe.steps.all() %}
            <li class="flex gap-4 rounded-lg bg-white p-4 shadow-sm">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-orange-100 font-semibold text-orange-800">
                {{ step.order }}
              </span>
              <div>
                <p class="font-medium">{{ step.instruction }}</p>
                {% if step.additional_info %}
                  <p class="mt-2 text-stone-600">{{ step.additional_info }}</p>
                {% endif %}
                <p class="mt-2 text-sm text-stone-500">{{ step.get_type_display() }}{% if step.duration %} &middot; {{ step.duration }} minutes{% endif %}</p>
              </div>
            </li>
          {% endfor %}
        </ol>
      {% else %}
        <p class="mt-3 text-stone-600">No steps added yet.</p>
      {% endif %}
    </section>
  </article>
{% endblock %}
