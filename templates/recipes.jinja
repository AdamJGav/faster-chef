{% extends "base.jinja" %}

{% block title %}Recipes | Faster Chef{% endblock %}
{% block meta_description %}Browse recipes and plan your next meal with Faster Chef.{% endblock %}

{% block content %}
  <section>
    <div class="mb-8">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-orange-700">Find your next meal</p>
        <div class="mb-8 flex items-center justify-between">
          <h1 class="mt-2 text-4xl font-bold tracking-tight">Recipes</h1>

          <a href="/recipe_form/1">
            <button class="float-right bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
              + Add Recipe
            </button>
          </a>
        </div>
    </div>

    {% if recipes %}
      <div class="grid gap-5 sm:grid-cols-2">
        {% for recipe in recipes %}
          {% include "components/recipe.jinja" %}
        {% endfor %}
      </div>
    {% else %}
      <p class="rounded-xl border border-orange-100 bg-white p-6 text-stone-600">
        No recipes yet. Add one in the <a href="/admin/" class="font-semibold text-orange-700 hover:underline">admin</a>.
      </p>
    {% endif %}
  </section>
{% endblock %}
