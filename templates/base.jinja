<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{% block meta_description %}Plan meals and prep smarter with Faster Chef.{% endblock %}">
    <title>{% block title %}Faster Chef{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {% block head %}{% endblock %}
  </head>
  <body class="flex min-h-screen flex-col bg-orange-50 text-stone-900">
    {% include "components/header.jinja" %}
    <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-12">
      {% block content %}{% endblock %}
    </main>
    {% include "components/footer.jinja" %}
    {% block scripts %}{% endblock %}
  </body>
</html>
