{% extends "base.jinja" %}

{% block title %}Faster Chef | Meal prep made easy{% endblock %}

{% block content %}
  <section class="flex min-h-[60vh] items-center">
    <div class="max-w-2xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-orange-700">
        Your kitchen, organised
      </p>
      <h1 class="text-5xl font-bold tracking-tight sm:text-7xl">Make meal prep feel easy.</h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-stone-600">
        Faster Chef is your home for planning meals and getting prep done.
        A little planning makes a delicious week.
      </p>
      <a href="/recipes/" class="mt-10 inline-flex rounded-full bg-orange-600 px-6 py-3 font-semibold text-white hover:bg-orange-700">
        Browse recipes
      </a>
    </div>
  </section>
{% endblock %}
